{
	"name": "nexafood-api",
	"version": "0.1.0",
	"description": "NestJS API starter — Better Auth, Prisma, Zod, Biome",
	"private": false,
	"license": "UNLICENSED",
	"type": "module",
	"engines": {
		"node": ">=22.12"
	},
	"packageManager": "bun@1.2.14",
	"scripts": {
		"dev": "nest start --watch --preserveWatchOutput",
		"build": "nest build",
		"start": "node dist/main.js",
		"check": "biome check .",
		"check:fix": "biome check . --write",
		"check-types": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:cov": "vitest run --coverage",
		"test:e2e": "vitest run --config vitest.config.e2e.ts",
		"db:generate": "prisma generate",
		"db:push": "prisma db push",
		"db:migrate": "prisma migrate dev",
		"db:deploy": "prisma migrate deploy",
		"db:studio": "prisma studio",
		"auth:generate": "better-auth generate --config src/auth/auth.cli.ts --output prisma/schema.prisma",
		"prepare": "lefthook install",
		"dev:debug": "nest start --debug --watch --preserveWatchOutput"
	},
	"dependencies": {
		"@nestjs/common": "11.2.5",
		"@nestjs/config": "^4.0.4",
		"@nestjs/core": "11.2.5",
		"@nestjs/platform-express": "11.2.5",
		"@nestjs/swagger": "^11.4.6",
		"@nestjs/terminus": "^11.1.1",
		"@nestjs/throttler": "^6.5.0",
		"@prisma/adapter-pg": "^7.9.1",
		"@prisma/client": "^7.9.1",
		"@swc/helpers": "^0.5.23",
		"@thallesp/nestjs-better-auth": "^2.7.0",
		"better-auth": "^1.6.26",
		"dotenv": "^17.3.1",
		"helmet": "^8.3.0",
		"nestjs-pino": "^4.6.1",
		"nestjs-zod": "^5.5.0",
		"pino": "^10.3.1",
		"pino-http": "^11.0.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@better-auth/cli": "^1.4.21",
		"@biomejs/biome": "^2.5.7",
		"@nestjs/cli": "^11.0.10",
		"@nestjs/schematics": "^11.0.9",
		"@nestjs/testing": "11.2.5",
		"@swc/cli": "^0.8.1",
		"@swc/core": "^1.15.47",
		"@types/express": "^5.0.3",
		"@types/node": "^22.15.3",
		"@types/supertest": "^6.0.3",
		"@vitest/coverage-v8": "^4.1.10",
		"lefthook": "^2.1.10",
		"pino-pretty": "^13.1.3",
		"prisma": "^7.9.1",
		"supertest": "^7.2.2",
		"tsx": "^4.23.9",
		"typescript": "5.9.3",
		"unplugin-swc": "^1.5.10",
		"vitest": "^4.1.10"
	},
	"trustedDependencies": [
		"@biomejs/biome",
		"@prisma/client",
		"@prisma/engines",
		"@scarf/scarf",
		"@swc/core",
		"better-sqlite3",
		"esbuild",
		"lefthook",
		"prisma"
	]
}
